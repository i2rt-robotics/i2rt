<mujoco model="no_gripper">
  <compiler angle="radian"/>

  <worldbody>
    <body name="gripper" pos="0 0 0" quat="0 0.70711 0.70711 0">
      <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-9 1e-9 1e-9"/>
      <!-- Both sites carry the flange's axes, the passive-XMI tool frame: X along the jaw stroke, Y down
           (away from the wrist camera), Z the approach. Each quat undoes the root body's. -->
      <site name="tcp_site" pos="0 0 0" quat="0 0.70711 0.70711 0" size="0.005" rgba="1 0 0 1"/>
      <site name="grasp_site" pos="0 0 0" quat="0 0.70711 0.70711 0" size="0.005" rgba="0 1 0 1"/>
    </body>
  </worldbody>
</mujoco>
