<?xml version="1.0"?>
<!-- YAM dual-arm station with crank_4310 grippers and a gantry-mounted Intel RealSense D405.

     The arms, the left->right base offset and the whole top-camera chain are the linear station
     (yam_station_linear_4310_d405.urdf) unchanged; only the {side}_gripper subtree differs. That
     subtree is grafted from arm/yam/v1/yam_crank_4310_d405.xml, which is an MJCF (there is no
     crank URDF), so this file is authored from a MuJoCo model rather than the other way round.
     It reproduces that model's flange->camera frame to 0.434 um / 6.75 arcsec, the residual of
     writing the chain as whole-degree rpy constants. See README.md.

     The wrist-camera link frames are the mesh frames, so every camera <visual><origin> is
     identity and each <inertial> is the STL's unit-density (1 kg/m^3) property, the same
     convention the CAD export used for the linear station's camera parts.

     `left_base` is the model root. -->
<robot name="yam_station_crank_4310_d405">
    <material name="0.647059_0.647059_0.647059_0.000000_0.000000">
        <color rgba="0.647059 0.647059 0.647059 1" />
    </material>
    <material name="1.000000_0.600000_0.000000_0.000000_0.000000">
        <color rgba="1 0.6 0 1" />
    </material>
    <material name="0.749020_0.749020_0.749020_0.000000_0.000000">
