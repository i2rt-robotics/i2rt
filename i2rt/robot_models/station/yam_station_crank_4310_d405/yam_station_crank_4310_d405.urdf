<?xml version="1.0"?>
<!-- YAM dual-arm station with crank_4310 grippers and a gantry-mounted Intel RealSense D405.

     The arms, the left->right base offset and the whole top camera are the linear station
     (yam_station_linear_4310_d405.urdf) unchanged; only the {side}_gripper subtree differs. That
     subtree was grafted from arm/yam/v1/yam_crank_4310_d405.xml, an MJCF (there is no crank URDF),
     so this file was authored from a MuJoCo model rather than the other way round. It reproduced
     that model's flange->camera frame to 0.434 um / 6.75 arcsec, the residual of writing the chain
     as whole-degree rpy constants. That MJCF has since been removed; see git history for it.

     Each camera is a single link. The export's per-part chain (bracket, cable holder, D405 body)
     is baked into one mesh expressed in the optical frame, so every camera <visual><origin> is
     identity and the link frame, the mesh frame and the optical frame are the same frame. Those
     merged meshes live in ../assets/; d405_top.stl is shared with the linear station. Each camera
     <inertial> is the sum of the baked parts' unit-density (1 kg/m^3) properties, the convention
     the CAD export used.

     `left_base` is the model root. -->
<robot name="yam_station_crank_4310_d405">
    <material name="1.000000_0.600000_0.000000_0.000000_0.000000">
        <color rgba="1 0.6 0 1" />
    </material>
    <material name="0.749020_0.749020_0.749020_0.000000_0.000000">
        <color rgba="0.74902 0.74902 0.74902 1" />
    </material>
    <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1" />
    </material>
    <material name="0.725490_0.450980_0.317647_0.000000_0.000000">
        <color rgba="0.72549 0.45098 0.317647 1" />
    </material>
    <material name="0.000000_0.400000_0.600000_0.000000_0.000000">
        <color rgba="0 0.4 0.6 1" />
    </material>
    <material name="0.552941_0.580392_0.203922_0.000000_0.000000">
        <color rgba="0.552941 0.580392 0.203922 1" />
    </material>
    <material name="0.545098_0.525490_0.419608_0.000000_0.000000">
        <color rgba="0.545098 0.52549 0.419608 1" />
    </material>
    <material name="0.827451_0.623529_0.784314_0.000000_0.000000">
        <color rgba="0.827451 0.623529 0.784314 1" />
    </material>
    <material name="0.317647_0.121569_0.498039_0.000000_0.000000">
        <color rgba="0.317647 0.121569 0.498039 1" />
    </material>

